{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed FileInput (object-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mimeType",
    "size",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "name": {
      "type": "string"
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64"
    }
  }
}
